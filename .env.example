# =========================================================================
# Adruva Solution Website - Consolidated Environment Variables Example
# Copy keys to apps/web/.env.local and apps/api/.env respectively
# Do NOT commit actual credentials to Git
# =========================================================================

# -------------------------------------------------------------------------
# Next.js Frontend Configuration (apps/web/.env.local)
# -------------------------------------------------------------------------
# App url of the Next.js client
NEXT_PUBLIC_APP_URL=http://localhost:3000
# NestJS backend API url
NEXT_PUBLIC_API_URL=http://localhost:3001

# NextAuth configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=                  # Generate using: openssl rand -base64 32

# Google OAuth (for admin panel authentication)
GOOGLE_CLIENT_ID=                 # From Google Cloud Console
GOOGLE_CLIENT_SECRET=             # From Google Cloud Console

# Google reCAPTCHA v3 Site Key
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=   # From Google reCAPTCHA Admin Panel

# Google Analytics GA4 Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=    # G-XXXXXXXXXX format

# Calendly Scheduling Link
NEXT_PUBLIC_CALENDLY_URL=         # E.g., https://calendly.com/your-username/30min

# Sentry Frontend DSN
NEXT_PUBLIC_SENTRY_DSN=           # From Sentry Project Settings

# -------------------------------------------------------------------------
# NestJS Backend Configuration (apps/api/.env)
# -------------------------------------------------------------------------
# App environment and port
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database URL
DATABASE_URL=postgresql://user:pass@localhost:5432/adruvacms

# Google OAuth Credentials (must match frontend client credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google reCAPTCHA v3 Secret Key
RECAPTCHA_SECRET_KEY=             # From Google reCAPTCHA Admin Panel

# Cloudinary Storage Configurations
CLOUDINARY_CLOUD_NAME=            # From Cloudinary Dashboard
CLOUDINARY_API_KEY=               # From Cloudinary Dashboard
CLOUDINARY_API_SECRET=            # From Cloudinary Dashboard

# Gmail SMTP Email Server Configurations
GMAIL_USER=                       # Outbox email address
GMAIL_APP_PASSWORD=               # Gmail App Password (not standard account password)
TEAM_EMAIL=                       # Inbox email address to receive lead notifications

# Meta WhatsApp Business API Configurations
META_WHATSAPP_TOKEN=              # WhatsApp Cloud API System User Token
META_PHONE_NUMBER_ID=             # WhatsApp Phone Number ID
TEAM_WHATSAPP=                    # Notification recipient phone number with country code (e.g. +91...)

# AdruvaCRM Webhook Configurations
ADRUVA_CRM_WEBHOOK_URL=           # Lead push endpoint in CRM
ADRUVA_CRM_WEBHOOK_SECRET=        # Shared key to verify webhook signature

# Sentry Backend DSN
SENTRY_DSN=                       # From Sentry Project Settings
