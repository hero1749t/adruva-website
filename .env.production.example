# =========================================================================
# Adruva Solution Website - Production Environment Variables Example
# Copy keys to Vercel (Frontend) and Railway (Backend) respectively.
# Do NOT commit actual credentials or production files to Git.
# =========================================================================

# -------------------------------------------------------------------------
# NEXT.JS FRONTEND (Vercel Dashboard)
# -------------------------------------------------------------------------
# The public-facing production URL of the Next.js client
NEXT_PUBLIC_APP_URL=https://adruvaSolution.com

# The public-facing production URL of the NestJS API
NEXT_PUBLIC_API_URL=https://api.adruvaSolution.com

# NextAuth base URL (must match the frontend URL)
NEXTAUTH_URL=https://adruvaSolution.com

# Random 32-character secret for NextAuth token encryption
# Generate via: openssl rand -base64 32
NEXTAUTH_SECRET=

# Google OAuth Credentials (for admin login)
# Obtained from: Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google reCAPTCHA v3 Site Key (public, invisible captcha)
# Obtained from: Google reCAPTCHA Admin Console (v3 Admin)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Google Analytics GA4 Measurement ID
# Obtained from: Google Analytics -> Admin -> Data Streams (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Calendly Scheduling Widget URL
# E.g., https://calendly.com/adruva/discovery-call
NEXT_PUBLIC_CALENDLY_URL=

# Sentry DSN for Frontend Error Tracking
# Obtained from: Sentry Project Settings -> Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=

# Team WhatsApp contact number displayed in the UI (with country code, e.g. +91XXXXXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER=


# -------------------------------------------------------------------------
# NESTJS BACKEND (Railway Dashboard)
# -------------------------------------------------------------------------
# Application runtime environment configuration
NODE_ENV=production
PORT=3001

# The frontend origin URL (used for CORS configuration)
FRONTEND_URL=https://adruvaSolution.com

# Railway PostgreSQL database connection string
# Generated automatically by Railway when adding the PostgreSQL service
# E.g., postgresql://postgres:password@junction.railway.internal:5432/railway
DATABASE_URL=

# Google OAuth Credentials (must match the frontend values for token verification)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google reCAPTCHA v3 Secret Key
# Obtained from: Google reCAPTCHA Admin Console (v3 Admin)
RECAPTCHA_SECRET_KEY=

# Cloudinary Storage Configurations (for blog/portfolio image uploads)
# Obtained from: Cloudinary Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gmail SMTP Email Server Configurations (for form lead notifications)
# GMAIL_USER: the email address sending the alerts (e.g. team@gmail.com)
# GMAIL_APP_PASSWORD: 16-character App Password (not your standard password, requires 2FA)
# TEAM_EMAIL: the email address receiving the notifications
GMAIL_USER=
GMAIL_APP_PASSWORD=
TEAM_EMAIL=

# Meta WhatsApp Cloud API Configurations (for instant WhatsApp alerts)
# META_WHATSAPP_TOKEN: System User Access Token from Meta Business Manager
# META_PHONE_NUMBER_ID: Phone Number ID from App Setup -> WhatsApp -> Getting Started
# TEAM_WHATSAPP: WhatsApp number receiving notifications (with country code, e.g. +91XXXXXXXXXX)
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
TEAM_WHATSAPP=

# AdruvaCRM Webhook Configurations (for automatic lead sync)
# ADRUVA_CRM_WEBHOOK_URL: Webhook URL of AdruvaCRM (leads ingestion endpoint)
# ADRUVA_CRM_WEBHOOK_SECRET: Shared secret key used to sign the webhook payload HMAC
ADRUVA_CRM_WEBHOOK_URL=
ADRUVA_CRM_WEBHOOK_SECRET=

# Sentry DSN for Backend Error Tracking
# Obtained from: Sentry Project Settings -> Client Keys (DSN)
SENTRY_DSN=
